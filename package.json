{
  "name": "@webergency-utils/mongodb-model",
  "version": "0.0.1",
  "description": "Type-safe MongoDB model abstraction",
  "author": "radixxko",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "coverage": "vitest run --config vitest.coverage.config.ts --coverage",
    "coverage:unit": "vitest run --coverage",
    "fuzz": "jazzer fuzz_index.cjs",
    "clean": "rm -rf ./dist/*",
    "build": "npm run clean && tsc && tsc -p tsconfig.esm.json && echo '{\"type\":\"module\"}' > dist/esm/package.json",
    "typecheck:example": "tsc -p example/tsconfig.json",
    "version": "npm run build && npm publish --access public"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webergency-utils/mongodb-model.git"
  },
  "dependencies": {
    "@liqd-js/flow": "^1.5.0",
    "@webergency-utils/aggregator": "^0.0.4",
    "@webergency-utils/mongodb-query-optimizer": "^0.0.5",
    "@webergency-utils/object-hash": "^1.1.2",
    "mongodb": "^7.0.0",
    "snappy": "^7.3.3"
  },
  "devDependencies": {
    "@jazzer.js/core": "^4.0.0",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
